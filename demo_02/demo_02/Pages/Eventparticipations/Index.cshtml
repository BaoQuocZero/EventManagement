@page
@model demo_02.Pages.EventParticipations.IndexModel
@{
    ViewData["Title"] = "Danh sách tham gia sự kiện";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-black text-white d-flex justify-content-between align-items-center">
                    <h3 class="m-0"><i class="fas fa-users"></i> Danh sách tham gia sự kiện</h3>
                </div>

                <div class="card-body">
                    <div id="gridContainer"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DevExtreme DataGrid Script -->
<script>
        $(function () {
        $("#gridContainer").dxDataGrid({
            dataSource: "/EventParticipations/Index?handler=Data", // Gọi API thay vì serialize model
            keyExpr: "ParticipationId",
            showBorders: true,
            columnAutoWidth: true,
            paging: {
                pageSize: 5
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            columns: [
                { dataField: "ParticipationId", caption: "Mã tham gia" },
                { dataField: "EventName", caption: "Tên sự kiện" },
                { dataField: "UserName", caption: "Người dùng" },
                { dataField: "ParticipationStatus", caption: "Trạng thái" },
                { dataField: "ParticipationTime", caption: "Thời gian tham gia", dataType: "date" },
                { dataField: "EarnedPoints", caption: "Điểm" },
                {
                    caption: "Hành động",
                    cellTemplate: function (container, options) {
                        var id = options.data.ParticipationId;
                        $("<a>", {
                            href: "/Eventparticipations/Details?id=" + id,
                            class: "btn btn-info btn-sm",
                            html: '<i class="fas fa-eye"></i> Xem'
                        }).appendTo(container);

                        $("<a>", {
                            href: "/Eventparticipations/Edit?id=" + id,
                            class: "btn btn-warning btn-sm ms-2",
                            html: '<i class="fas fa-edit"></i> Sửa'
                        }).appendTo(container);

                        $("<button>", {
                            class: "btn btn-danger btn-sm ms-2",
                            html: '<i class="fas fa-trash"></i> Xóa',
                            click: function () {
                                if (confirm("Bạn có chắc chắn muốn xóa?")) {
                                    $.post("./Index?handler=Delete&id=" + id, function () {
                                        location.reload();
                                    });
                                }
                            }
                        }).appendTo(container);
                    }
                }
            ]
        });
    });
</script>

<!-- Font Awesome (Nếu bạn chưa có) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
