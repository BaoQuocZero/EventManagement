@page
@model DetailsModel
@{
    ViewData["Title"] = "Chi tiết sự kiện";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white text-center">
                    <h3><i class="fas fa-calendar-check"></i> Chi tiết sự kiện</h3>
                </div>

                <div class="card-body">
                    <div id="eventDetails"></div>
                    <div id="participationPieChart"></div>
                </div>

                <div class="card-footer text-center">
                    <a asp-page="Index" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        console.log(">>>>>>>>>>>", @Html.Raw(Json.Serialize(Model.Event)))
        $("#eventDetails").dxForm({
            formData: @Html.Raw(Json.Serialize(Model.Event)),
            readOnly: true,
            colCount: 2,
            items: [
                { dataField: "EventName", label: { text: "Tên sự kiện" }, editorType: "dxTextBox" },
                { dataField: "EventTime", label: { text: "Thời gian bắt đầu" }, editorType: "dxDateBox", editorOptions: { type: "datetime" } },
                { dataField: "EndTime", label: { text: "Thời gian kết thúc" }, editorType: "dxDateBox", editorOptions: { type: "datetime" } },
                { dataField: "Location", label: { text: "Địa điểm" }, editorType: "dxTextBox" },
                { dataField: "Description", label: { text: "Mô tả" }, editorType: "dxTextArea" },
                { dataField: "Eventtypes.EventtypesName", label: { text: "Loại sự kiện" }, editorType: "dxTextBox" },
                { dataField: "RequiredParticipants", label: { text: "Số lượng tối thiểu" }, editorType: "dxNumberBox" },
                { dataField: "MaxParticipants", label: { text: "Số lượng tối đa" }, editorType: "dxNumberBox" },

                // Thêm các thông tin mới
                { dataField: "TotalParticipants", label: { text: "Tổng số người tham gia" }, editorType: "dxNumberBox" },
                { dataField: "AbsentCount", label: { text: "Số lượng vắng mặt" }, editorType: "dxNumberBox" },
                { dataField: "TotalDonations", label: { text: "Tổng số tiền donate" }, editorType: "dxNumberBox", editorOptions: { format: "#,##0 VNĐ" } },
                { dataField: "ParticipationRate", label: { text: "Tỷ lệ tham gia (%)" }, editorType: "dxNumberBox", editorOptions: { format: "#.## %" } }
            ]
        });
        var eventData = @Html.Raw(Json.Serialize(Model.Event));
        console.log("eventData: ", eventData)
        var chartData = [
            { category: "Tham gia", value: eventData.TotalParticipants },
            { category: "Vắng mặt", value: eventData.AbsentCount }
        ];

        $("#participationPieChart").dxPieChart({
            type: "doughnut",
            palette: "Soft Pastel",
            dataSource: chartData,
            series: [{
                argumentField: "category",
                valueField: "value",
                label: {
                    visible: true,
                    format: "fixedPoint",
                    precision: 0,
                    connector: { visible: true }
                }
            }],
            legend: {
                horizontalAlignment: "center",
                verticalAlignment: "bottom"
            },
            tooltip: {
                enabled: true,
                format: {
                    type: "fixedPoint",
                    precision: 0
                }
            },
            title: "Tỷ lệ tham gia sự kiện: " + (eventData.ParticipationRate * 100).toFixed(2) + "%"
        });
    });
</script>

