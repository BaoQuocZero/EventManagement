@page
@model demo_02.Pages.Events.PreviewModel
@{
}

<div class="container mt-4">
    <!-- Countdown Timer -->
    <div class="hero text-center">
        <h1 class="card-title text-center text-light">@Model.Event.EventName</h1>
        <p class="text-light text-center">Sự kiện đặc biệt diễn ra vào <strong>@Model.Event.EventTime</strong> tại <strong>@Model.Event.Location</strong>. Đừng bỏ lỡ cơ hội tham gia!</p>
        <h2 class="text-light">Thời gian đến sự kiện</h2>
        <div class="timebox d-flex justify-content-center gap-4">
            <div class="time">
                <h2 id="days">00</h2>
                <p>Ngày</p>
            </div>
            <div class="time">
                <h2 id="hours">00</h2>
                <p>Giờ</p>
            </div>
            <div class="time">
                <h2 id="minutes">00</h2>
                <p>Phút</p>
            </div>
            <div class="time">
                <h2 id="seconds">00</h2>
                <p>Giây</p>
            </div>
        </div>
    </div>
    <hr>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <article class="card shadow-lg border-0 rounded-4">
                <div class="card-body">
                    <p class="card-text">@Model.Event.Description</p>
                    <h4 class="mt-4">Thông tin chi tiết:</h4>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Loại sự kiện:</strong> @Model.Event.Eventtypes.EventtypesName - Một sự kiện đầy hấp dẫn dành cho bạn!</li>
                        <li class="list-group-item"><strong>Thời gian kết thúc:</strong> @Model.Event.EndTime - Hãy sắp xếp thời gian để không bỏ lỡ phút giây nào!</li>
                        <li class="list-group-item"><strong>Số lượng tối thiểu:</strong> @Model.Event.RequiredParticipants người - Chúng ta cần đủ số lượng để sự kiện diễn ra tốt nhất!</li>
                        <li class="list-group-item"><strong>Số lượng tối đa:</strong> @Model.Event.MaxParticipants người - Hãy đăng ký sớm để giữ chỗ!</li>
                        <li class="list-group-item"><strong>Dress Code:</strong> @Model.Event.DressCode - Đừng quên mặc trang phục phù hợp để có trải nghiệm tốt nhất.</li>
                        <li class="list-group-item"><strong>Link nhóm sự kiện:</strong> <a href="@Model.Event.EventGroupLink" target="_blank">Tham gia ngay</a> để cập nhật thông tin mới nhất!</li>
                        <li class="list-group-item"><strong>Danh sách điểm danh:</strong> <a href="@Model.Event.AttendanceListLink" target="_blank">Xem danh sách</a> để kiểm tra tình trạng đăng ký của bạn.</li>
                    </ul>
                </div>
                <div class="card-footer text-center">
                    <a asp-page="Participants" asp-route-eventId="@Model.Event.EventsId" class="btn btn-primary btn-lg">
                        <i class="fas fa-users"></i> Xem người tham gia
                    </a>
                    <a asp-page="Preview" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </article>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var eventData = @Html.Raw(Json.Serialize(Model.Event));
    console.log("Event Data: ", eventData);

    // Countdown Timer
    function updateCountdown() {
            var eventTime = new Date(eventData.EventTime).getTime();
            var now = new Date().getTime();
            var timeLeft = eventTime - now;

            if (timeLeft > 0) {
                var days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                var hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                var minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

                document.getElementById("days").innerText = days;
                document.getElementById("hours").innerText = hours;
                document.getElementById("minutes").innerText = minutes;
                document.getElementById("seconds").innerText = seconds;
            } else {
                document.querySelector(".hero").innerHTML = "<h2 class='text-light'>Sự kiện đã bắt đầu! Chúc bạn có một trải nghiệm tuyệt vời!</h2>";
            }
        }
        setInterval(updateCountdown, 1000);
        updateCountdown();
</script>
<style>
    * {
        padding: 0;
        margin: 0;
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    .hero {
        width: 100%; /* Chiều rộng toàn bộ màn hình */
        height: 100vh; /* Chiều cao toàn bộ màn hình */
        background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/images/background.png'); /* Đường dẫn ảnh */
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        text-align: center;
        padding: 20px;
    }

    .timebox {
        display: flex;
        gap: 50px; /* Giảm khoảng cách nếu quá xa */
        flex-wrap: wrap; /* Đảm bảo không bị tràn trên màn hình nhỏ */
    }

    .time {
        background: rgba(255, 255, 255, 0.2); /* Tạo hiệu ứng nền mờ */
        padding: 15px;
        border-radius: 10px;
        min-width: 120px;
    }

    h1 {
        font-size: 4rem;
        font-weight: 500;
        margin-bottom: 20px;
    }

    .time h2 {
        font-size: 5rem;
        font-weight: 100;
    }
</style>