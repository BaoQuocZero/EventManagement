@page
@model Index
@{
    ViewData["Title"] = "Trang chủ";
}

<p>UserId trong Session: @Model.SessionUserId</p>
<p>Thời gian lấy dữ liệu: @Model.LoadTime ms</p>

<!-- Thêm CSS & JS của DevExtreme -->
<link rel="stylesheet" href="https://cdn3.devexpress.com/jslib/latest/css/dx.light.css" />
<script src="https://cdn3.devexpress.com/jslib/latest/js/dx.all.js"></script>

<h2>Thống kê nhanh</h2>

<!-- Bảng thống kê nhanh -->
<div id="dashboardGrid"></div>

<!-- Biểu đồ -->
<div class="chart-container">
    <div id="eventChart" class="chart-item"></div>
    <div id="statusPieChart" class="chart-item"></div>
    <div id="participationChart" class="chart-item"></div>
    <div id="donationChart" class="chart-item"></div>
</div>

@section Scripts {
    <script>
        $(function () {
            var statisticsData = [{
                totalEvents: @Model.TotalEvents,
                totalParticipants: @Model.TotalParticipants,
                topEvent: "@Html.Raw(Model.TopEvent)",
                status: "Đang mở: @Model.StatusData["Đang mở"], Sắp diễn ra: @Model.StatusData["Sắp diễn ra"], Đã kết thúc: @Model.StatusData["Đã kết thúc"]"
            }];

            var eventData = @Json.Serialize(Model.EventTypesData.Select(e => new { category = e.Key, count = e.Value }));
            var statusData = [
                { status: "Đang mở", count: @Model.StatusData["Đang mở"] },
                { status: "Sắp diễn ra", count: @Model.StatusData["Sắp diễn ra"] },
                { status: "Đã kết thúc", count: @Model.StatusData["Đã kết thúc"] }
            ];

            // Cấu hình bảng DevExtreme
            $("#dashboardGrid").dxDataGrid({
                dataSource: statisticsData,
                columns: [
                    { dataField: "totalEvents", caption: "Tổng số sự kiện", dataType: "number" },
                    { dataField: "totalParticipants", caption: "Số sinh viên tham gia", dataType: "number" },
                    { dataField: "topEvent", caption: "Sự kiện đông nhất", dataType: "string" },
                    { dataField: "status", caption: "Trạng thái sự kiện", dataType: "string" }
                ],
                showBorders: true,
                paging: { enabled: false }
            });

            // Biểu đồ thống kê sự kiện theo loại
            $("#eventChart").dxChart({
                dataSource: eventData,
                commonSeriesSettings: { argumentField: "category", type: "bar" },
                series: [{ valueField: "count", name: "Số lượng" }],
                legend: { visible: false },
                title: "Số lượng sự kiện theo loại"
            });

            // Biểu đồ tròn - Trạng thái sự kiện
            $("#statusPieChart").dxPieChart({
                dataSource: statusData,
                series: [{
                    argumentField: "status",
                    valueField: "count",
                    label: { visible: true, format: "fixedPoint", connector: { visible: true } }
                }],
                title: "Phân bố trạng thái sự kiện"
            });

            var donationData = @Html.Raw(Model.TopDonatedEventsJson); // Dùng JSON thay vì List<> từ Model
            $("#donationChart").dxChart({
                dataSource: donationData,
                commonSeriesSettings: {
                    argumentField: "EventName",
                    type: "bar"
                },
                series: [{
                    valueField: "TotalDonation",
                    name: "Số tiền quyên góp",
                    color: "#ff9800"
                }],
                title: {
                    text: "Top 5 Sự kiện có Donation cao nhất",
                    font: { size: 18 }
                },
                legend: { visible: false },
                argumentAxis: {
                    label: {
                        rotationAngle: -45
                    }
                },
                tooltip: {
                    enabled: true,
                    format: {
                        type: "fixedPoint",
                        precision: 0
                    }
                }
            });

            var monthlyData = @Html.Raw(Model.MonthlyStatsJson); // Lấy JSON từ Model
            // Biểu đồ số lượt tham gia
            $("#participationChart").dxChart({
                dataSource: monthlyData,
                commonSeriesSettings: {
                    argumentField: "Month",
                    type: "line"
                },
                series: [
                    {
                        valueField: "ParticipationCount",
                        name: "Số lượt tham gia",
                        color: "#1e88e5"
                    }
                ],
                title: {
                    text: "Số lượt tham gia sự kiện theo tháng",
                    font: { size: 18 }
                },
                legend: {
                    visible: false
                },
                argumentAxis: {
                    label: {
                        customizeText: function() {
                            return "Tháng " + this.value;
                        }
                    }
                },
                tooltip: {
                    enabled: true,
                    format: {
                        type: "fixedPoint",
                        precision: 0
                    }
                }
            });

            // Biểu đồ tổng tiền quyên góp
            $("#donationChart").dxChart({
                dataSource: monthlyData,
                commonSeriesSettings: {
                    argumentField: "Month",
                    type: "line"
                },
                series: [
                    {
                        valueField: "TotalDonationAmount",
                        name: "Tổng tiền quyên góp",
                        color: "#ff9800"
                    }
                ],
                title: {
                    text: "Tổng số tiền quyên góp theo tháng",
                    font: { size: 18 }
                },
                legend: {
                    visible: false
                },
                argumentAxis: {
                    label: {
                        customizeText: function() {
                            return "Tháng " + this.value;
                        }
                    }
                },
                tooltip: {
                    enabled: true,
                    format: {
                        type: "fixedPoint",
                        precision: 0
                    }
                }
            });

        });
    </script>
}

<style>
    .chart-container {
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        margin-top: 20px;
    }
    .chart-item {
        width: 45%;
        min-width: 300px;
        height: 300px;
    }
</style>


