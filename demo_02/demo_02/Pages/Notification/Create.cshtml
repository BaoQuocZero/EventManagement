@page
@model demo_02.Pages.Notification.CreateModel
@{
    ViewData["Title"] = "Tạo thông báo mới";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h3 class="m-0"><i class="fas fa-plus-circle me-2"></i> Tạo thông báo mới</h3>
                </div>

                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Notification.Title" class="form-label">Tiêu đề</label>
                            <input asp-for="Notification.Title" class="form-control" placeholder="Nhập tiêu đề..." />
                            <span asp-validation-for="Notification.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notification.Message" class="form-label">Nội dung</label>
                            <textarea asp-for="Notification.Message" class="form-control" rows="4" placeholder="Nhập nội dung thông báo..."></textarea>
                            <span asp-validation-for="Notification.Message" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notification.NotificationtypesId" class="form-label">Loại thông báo</label>
                            <select asp-for="Notification.NotificationtypesId"
                                    asp-items="@(new SelectList(Model.NotificationTypes, "NotificationtypesId", "NotificationtypesName"))"
                                    class="form-select">
                                <option value="">-- Chọn loại thông báo --</option>
                            </select>

                            <span asp-validation-for="Notification.NotificationtypesId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Notification/Index" class="btn btn-light"><i class="fas fa-arrow-left"></i> Hủy</a>
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
