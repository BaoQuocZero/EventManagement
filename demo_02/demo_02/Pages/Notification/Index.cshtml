@page
@model demo_02.Pages.Notification.IndexModel
@{
    ViewData["Title"] = "Danh sách thông báo";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <div class="card shadow-lg border-0 rounded-4 bg-dark">
                <div class="card-header custom-header text-white d-flex justify-content-between align-items-center">
                    <h3 class="m-0">
                        <i class="fas fa-bell custom-icon"></i> Danh sách thông báo
                    </h3>
                    <a asp-page="Create" class="btn btn-dark d-flex align-items-center justify-content-center p-2">
                        <i class="fas fa-plus-circle fs-4"></i>
                    </a>
                </div>

                <div class="card-body">
                    <div id="gridContainer"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DevExtreme DataGrid Script -->
<script>
       $(function () {
        var grid = $("#gridContainer").dxDataGrid({
            dataSource: DevExpress.data.AspNet.createStore({
                key: "NotificationsId",
                loadUrl: "./Index?handler=Data",
                deleteUrl: "./Index?handler=Delete"
            }),
            remoteOperations: true,
            showBorders: true,
            columnAutoWidth: true,
            width: "100%",
            paging: {
                pageSize: 10
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [5, 10, 20],
                showInfo: true
            },
            filterRow: { visible: true },
            searchPanel: { visible: true, width: 240, placeholder: "Tìm kiếm thông báo..." },
            columns: [
                { dataField: "NotificationsId", caption: "Mã thông báo", width: 120 },
                { dataField: "Title", caption: "Tiêu đề", width: 250 },
                { dataField: "Message", caption: "Nội dung", width: 500 },
                {
                    caption: "Hành động",
                    alignment: "center",
                    width: 150,
                    cellTemplate: function (container, options) {
                        var id = options.data.NotificationsId;

                        $("<a>", {
                            href: "/Notification/Details/" + id,
                            class: "btn btn-sm action-icon",
                            html: '<i class="fas fa-eye"></i>'
                        }).appendTo(container);

                        $("<a>", {
                            href: "/Notification/Edit?id=" + id,
                            class: "btn btn-sm action-icon ms-2",
                            html: '<i class="fas fa-edit"></i>'
                        }).appendTo(container);

                        $("<button>", {
                            class: "btn btn-sm action-icon ms-2",
                            html: '<i class="fas fa-trash"></i>',
                            click: function () {
                                deleteNotification(id);
                            }
                        }).appendTo(container);
                    }
                }
            ]
        }).dxDataGrid("instance");

        function deleteNotification(id) {
            if (confirm("Bạn có chắc chắn muốn xóa?")) {
                $.post("./Index?handler=Delete", { id: id }, function (response) {
                    if (response.success) {
                        grid.getDataSource().remove(id);
                        grid.refresh();
                    } else {
                        alert("Xóa thất bại!");
                    }
                }).fail(function () {
                    alert("Có lỗi xảy ra khi xóa thông báo.");
                });
            }
        }
    });

</script>

<!-- CSS Tùy Chỉnh -->
<style>
    /* Đổi màu icon trong header thành xanh dương */
    .custom-icon {
        color: #fff !important;
    }

    /* Nền danh sách thành màu đen */
    .bg-dark {
        background-color: #000 !important;
    }

    /* Đổi màu tất cả icon hành động thành xanh dương */
    .action-icon i {
        color: #000 !important;
        font-size: 16px;
    }

    .card-body {
        background-color: white;
    }
</style>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
