@page "{id:int}"
@model NotificationDetailsModel
@{
    ViewData["Title"] = "Chi tiết thông báo";
}

<div class="container mt-4">
    <h2>Chi tiết thông báo</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Tiêu đề:</dt>
        <dd class="col-sm-9">@Model.Notification.Title</dd>

        <dt class="col-sm-3">Nội dung:</dt>
        <dd class="col-sm-9">@Model.Notification.Message</dd>

        <dt class="col-sm-3">Loại thông báo:</dt>
        <dd class="col-sm-9">@Model.Notification.Notificationtypes?.Name</dd>

        <dt class="col-sm-3">Ngày tạo:</dt>
        <dd class="col-sm-9">@Model.Notification.CreateAt?.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">Trạng thái:</dt>
        <dd class="col-sm-9">@Model.Notification.Status</dd>
    </dl>
    <a asp-page="Notifications" class="btn btn-secondary">Quay lại</a>
</div>
