<body style="padding-top: 3.5rem;">

    <nav class="navbar navbar-dark bg-dark fixed-top navbar-expand-md">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">EventManagement</a>

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbar" aria-expanded="false" aria-controls="navbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="navbar" class="navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
                    <li class="nav-item"><a href="/Events/Index" class="nav-link">Events</a></li>
                    <li class="nav-item"><a href="/Users/Index" class="nav-link">Users</a></li>
                    <li class="nav-item"><a href="/Notifications/IndexNotification" class="nav-link">Notification</a></li>
                </ul>

                @inject demo_02.Servers.NotificationService NotificationService
                @{
                    var allNotifications = (await NotificationService.GetAllNotificationsAsync()).ToList(); // Lấy tất cả thông báo
                    @using demo_02.Models
                }

                <!-- Thêm div chứa hai icon để đảm bảo căn phải -->
                <div class="d-flex align-items-center ms-auto">
                    <!-- Icon Thông báo -->
                    <div class="dropdown notification-icon" style="right: 20px; top: 13px; color: white; position: absolute;">
                        <i id="notificationDropdown" class="bi bi-bell fs-5 position-relative">
                            <span id="notificationCount" class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill"
                                  style="display: @(allNotifications.Count > 0 ? "inline" : "none");">
                                @allNotifications.Count
                            </span>
                        </i>
                        <div id="notificationMenu" class="dropdown-menu p-3" style="width: 320px; max-height: 400px; overflow-y: auto;">
                            <h6 class="dropdown-header text-dark">Thông báo</h6>
                            <div id="notificationList">
                                @foreach (var notification in allNotifications.Take(5)) // Chỉ hiển thị 5 thông báo đầu tiên
                                {
                                    <div class="notification-item">
                                        <strong class="text-dark">@notification.Title</strong>
                                        <span class="text-muted ms-2 small d-block">@notification.Message</span>
                                    </div>
                                }
                            </div>
                            <div id="loading" style="display: none; text-align: center; padding: 10px;">
                                <span>Đang tải...</span>
                            </div>
                        </div>
                    </div>

                    <!-- Icon User -->
                    <div class="dropdown">
                        <a class="nav-link position-relative dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="/Profile">Hồ sơ</a></li>
                            <li><a class="dropdown-item" href="/Logout">Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>


    <main class="container" style="margin-top: 1.5rem;">
        @RenderBody()
    </main>
    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            var navLinks = document.querySelectorAll(".navbar-nav .nav-link");

            navLinks.forEach(function (link) {
                if (link.getAttribute("href").toLowerCase() === currentPath) {
                    link.classList.add("active"); // Đánh dấu active
                } else {
                    link.classList.remove("active"); // Loại bỏ active nếu không khớp
                }
            });
        });
    </script>

    @*     Phần script của thông báo *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var dropdownTrigger = document.getElementById("notificationDropdown");
            var dropdownMenu = document.getElementById("notificationMenu");

            dropdownTrigger.addEventListener("click", function (event) {
                event.stopPropagation();
                dropdownMenu.classList.toggle("show");
            });

            document.addEventListener("click", function (event) {
                if (!dropdownTrigger.contains(event.target) && !dropdownMenu.contains(event.target)) {
                    dropdownMenu.classList.remove("show");
                }
            });
        });
    </script>

    <script>
        let allNotifications = @Html.Raw(Json.Serialize(allNotifications ?? new List<Notification>()));
        console.log(allNotifications); // Kiểm tra dữ liệu
        // Chuyển danh sách thông báo vào JS
        let visibleCount = 5; // Số lượng thông báo ban đầu
        let isLoading = false;

        document.getElementById('notificationMenu').addEventListener('scroll', function () {
            const notificationMenu = this;
            if (notificationMenu.scrollTop + notificationMenu.clientHeight >= notificationMenu.scrollHeight - 10) {
                if (!isLoading && visibleCount < allNotifications.length) {
                    isLoading = true;
                    document.getElementById('loading').style.display = 'block';

                    setTimeout(() => {
                        let notificationList = document.getElementById('notificationList');
                        let newNotifications = allNotifications.slice(visibleCount, visibleCount + 5); // Lấy thêm 5 thông báo

                        newNotifications.forEach(notification => {
                            let div = document.createElement('div');
                            div.classList.add('notification-item');
                            div.innerHTML = `<strong class="text-dark">${notification.Title}</strong>
                             <span class="text-muted ms-2 small d-block">${notification.Message}</span>`; // Đảm bảo viết đúng `Title` và `Message`
                            notificationList.appendChild(div);
                        });


                        visibleCount += 5; // Cập nhật số lượng hiển thị
                        document.getElementById('loading').style.display = 'none';
                        isLoading = false;
                    }, 500); // Giả lập thời gian tải
                }
            }
        });
    </script>
    <style>
        .notification-icon {
            cursor: pointer;
        }

            .notification-item:hover {
                background: #f1f1f1;
            }

            #notificationMenu.show {
                display: block;
            }

        #notificationCount {
            font-size: 12px;
            padding: 3px 6px;
            border-radius: 50%;
            min-width: 20px;
            min-height: 20px;
            text-align: center;
            line-height: 14px;
        }

        #notificationMenu {
            display: none;
            position: absolute;
            right: 0;
            top: 40px;
            width: 500px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
            z-index: 1050;
            white-space: nowrap;
            overflow: hidden;
        }

        .notification-item {
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 60px; /* Đảm bảo chiều cao tối thiểu */
            padding: 10px;
            border-bottom: 1px solid #ddd;
            white-space: pre-line; /* Giữ đúng định dạng xuống dòng */
            word-wrap: break-word;
        }



    </style>
</body>

