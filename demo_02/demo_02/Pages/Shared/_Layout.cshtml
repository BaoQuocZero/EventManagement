<body style="padding-top: 3.5rem;">

    <nav class="navbar navbar-dark bg-dark fixed-top navbar-expand-md">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">EventManagement</a>

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbar" aria-expanded="false" aria-controls="navbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="navbar" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
                    <li class="nav-item">
                        <a href="/Events/Index" class="nav-link">Events</a>
                    </li>
                    <li class="nav-item">
                        <a href="/Eventparticipations/Index" class="nav-link">Event Participation</a>
                    </li>
                    <li class="nav-item">
                        <a href="/Users/Index" class="nav-link">Users</a>
                    </li>
                    <li>
                        <a href="/Notification/Index" class="nav-link">Notification</a>
                    </li>
                </ul>
                @* Thông báo *@
                @inject demo_02.Servers.NotificationService NotificationService
                @{
                    var notifications = (await NotificationService.GetAllNotificationsAsync()).Take(5).ToList();
                    var notificationCount = notifications.Count;
                }

                <div class="dropdown notification-icon" style="position: absolute; right: 20px; top: 10px; color: white;">
                    <a class="nav-link position-relative dropdown-toggle" href="javascript:void(0);" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-bell fs-5"></i>
                        @if (notificationCount > 0)
                        {
                            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill">
                                @notificationCount
                            </span>
                        }
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notificationDropdown">
                        @if (notificationCount > 0)
                        {
                            @foreach (var notification in notifications.Take(5))
                            {
                                <li>
                                    <a class="dropdown-item" href="/Notification/Details/@notification.NotificationsId">
                                        <strong>@notification.Title</strong> - @notification.Message
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li><span class="dropdown-item text-muted">Không có thông báo</span></li>
                        }
                    </ul>
                </div>

            </div>
        </div>
    </nav>

    <main class="container" style="margin-top: 1.5rem;">
        @RenderBody()
    </main>
    @RenderSection("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            var navLinks = document.querySelectorAll(".navbar-nav .nav-link");

            navLinks.forEach(function (link) {
                if (link.getAttribute("href").toLowerCase() === currentPath) {
                    link.classList.add("active"); // Đánh dấu active
                } else {
                    link.classList.remove("active"); // Loại bỏ active nếu không khớp
                }
            });
        });
    </script>

@*     Phần script của thông báo *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var dropdownTrigger = document.getElementById("notificationDropdown");
            var dropdownMenu = document.querySelector(".dropdown-menu");

            dropdownTrigger.addEventListener("click", function (event) {
                event.stopPropagation(); // Ngăn chặn sự kiện lan ra ngoài

                // Toggle class 'show' để bật/tắt dropdown
                dropdownMenu.classList.toggle("show");
            });

            // Đóng dropdown khi click ra ngoài
            document.addEventListener("click", function (event) {
                if (!dropdownTrigger.contains(event.target) && !dropdownMenu.contains(event.target)) {
                    dropdownMenu.classList.remove("show");
                }
            });

            // Ngăn dropdown đóng khi click vào nội dung dropdown
            dropdownMenu.addEventListener("click", function (event) {
                event.stopPropagation();
            });
        });
    </script>




    <style>
        /* Định dạng dropdown */
        .dropdown-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 40px;
            background: #fff;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
            border-radius: 8px;
            min-width: 300px;
            padding: 10px;
            z-index: 1000;
        }

            /* Hiển thị dropdown khi có class 'show' */
            .dropdown-menu.show {
                display: block;
            }

            /* Định dạng từng thông báo */
            .dropdown-menu li {
                list-style: none;
                border-bottom: 1px solid #eee;
                padding: 10px;
                font-size: 14px;
                transition: background 0.3s ease;
            }

                /* Hiệu ứng hover */
                .dropdown-menu li:hover {
                    background: #f5f5f5;
                }

                /* Định dạng chữ */
                .dropdown-menu li a {
                    text-decoration: none;
                    color: #333;
                    font-weight: 500;
                    display: block;
                }

                    /* Làm nổi bật tiêu đề thông báo */
                    .dropdown-menu li a strong {
                        font-weight: bold;
                        color: #222;
                    }

                /* Loại bỏ border cho thông báo cuối cùng */
                .dropdown-menu li:last-child {
                    border-bottom: none;
                }
    </style>
</body>

