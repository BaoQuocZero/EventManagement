                    @*     <div id="notificationMenu" class="dropdown-menu p-3" style="width: 320px; max-height: 400px; overflow-y: auto;"> *@
                    @*         <h6 class="dropdown-header text-dark">Thông báo</h6> *@
                    @*         <div id="notificationList"> *@
                    @*             @foreach (var notification in allNotifications.Take(5)) // Chỉ hiển thị 5 thông báo đầu tiên *@
                    @*             { *@
                    @*                 <div class="notification-item"> *@
                    @*                     <strong class="text-dark">@notification.Title</strong> *@
                    @*                     <span class="text-muted ms-2 small d-block">@notification.Message</span> *@
                    @*                 </div> *@
                    @*             } *@
                    @*         </div> *@
                    @*         <div id="loading" style="display: none; text-align: center; padding: 10px;"> *@
                    @*             <span>Đang tải...</span> *@
                    @*         </div> *@
                    @*     </div> *@
                    @* </div> *@

                    <!-- Icon User -->
                    <!-- Thêm DevExtreme DropDownButton -->
                    <div id="notificationDropdown"></div>
                    <div id="userDropdown"></div>


                </div>
            </div>
        </div>
    </nav>


    <main class="container" style="margin-top: 1.5rem;">
        @RenderBody()
    </main>
    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            var navLinks = document.querySelectorAll(".navbar-nav .nav-link");

            navLinks.forEach(function (link) {
                if (link.getAttribute("href").toLowerCase() === currentPath) {
                    link.classList.add("active"); // Đánh dấu active
                } else {
                    link.classList.remove("active"); // Loại bỏ active nếu không khớp
                }
            });
        });

         $(function () {
            $("#userDropdown").dxDropDownButton({
                icon: "user",
                text: "Tài khoản",
                items: [
                    { id: 1, text: "Hồ sơ", icon: "user"},
                    { id: 2, text: "Đăng xuất", icon: "runner", onClick: () => alert("Đăng xuất") }
                ],
                displayExpr: "text",
                keyExpr: "id",
                onItemClick: function (e) {
                    if (e.itemData.id === 1) {
                        // Chuyển hướng khi đăng xuất
                        window.location.href = "Account/Profile";
                    }
                    if (e.itemData.id === 2) {
                        // Chuyển hướng khi đăng xuất
                        window.location.href = "Account/logout";
                    }
                },
                elementAttr: {
                    style: "background-color: white; border: 1px solid #ccc; color: black;"
                }
            });
        });
    </script>

   @*  script phần thông báo *@
    <script>
        $(function () {
            let allNotifications = @Html.Raw(Json.Serialize(allNotifications ?? new List<Notification>()));

            $("#notificationDropdown").dxDropDownButton({
                icon: "bell",
                text: `Thông báo (${allNotifications.length})`,
                stylingMode: "contained",
                type: "default",
                dropDownOptions: {
                    width: 320,
                    height: "auto"
                },
                items: allNotifications.map(n => ({
                    text: n.Title,
                    hint: n.Message
                })),
                displayExpr: "text",
                onItemClick: function (e) {
                    alert(e.itemData.hint); // Hiển thị nội dung thông báo
                }
            });
        });
    </script>
    <style>
        .notification-icon {
            cursor: pointer;
        }

            .notification-item:hover {
                background: #f1f1f1;
            }

            #notificationMenu.show {
                display: block;
            }

        #notificationCount {
            font-size: 12px;
            padding: 3px 6px;
            border-radius: 50%;
            min-width: 20px;
            min-height: 20px;
            text-align: center;
            line-height: 14px;
        }

        #notificationMenu {
            display: none;
            position: absolute;
            right: 0;
            top: 40px;
            width: 500px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
            z-index: 1050;
            white-space: nowrap;
            overflow: hidden;
        }

        .notification-item {
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 60px; /* Đảm bảo chiều cao tối thiểu */
            padding: 10px;
            border-bottom: 1px solid #ddd;
            white-space: pre-line; /* Giữ đúng định dạng xuống dòng */
            word-wrap: break-word;
        }



    </style>
</body>

</html>