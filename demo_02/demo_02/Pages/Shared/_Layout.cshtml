<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="">
    <meta name="author" content="">

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        EventManagement
    </title>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

    <!-- Quill Editor -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <!-- DevExpress CSS -->
    <link rel="stylesheet" href="https://cdn.devexpress.com/22.2/css/dx.material.blue.light.min.css" />

    <!-- Thư viện ExcelJS & FileSaver.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    <!-- Bootstrap & jQuery -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Sử dụng Bootstrap Bundle (đã bao gồm Popper.js) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- Favicon -->
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- DevExtreme CSS -->
    <link href="~/css/devextreme/dx.light.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/Site.css" />

    <!-- DevExtreme & jQuery -->
    <script src="~/js/devextreme/jquery.js"></script>
    <script src="~/js/devextreme/dx.all.js"></script>

    <!-- DevExtreme ASP.NET -->
    <script src="~/js/devextreme/aspnet/dx.aspnet.mvc.js"></script>
    <script src="~/js/devextreme/aspnet/dx.aspnet.data.js"></script>

    <!-- Bootstrap JavaScript (nếu cần) -->
    <script src="~/js/devextreme/bootstrap.js"></script>

</head>

<body style="padding-top: 3.5rem;">

    <nav class="navbar navbar-dark bg-dark fixed-top navbar-expand-md">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">EventManagement</a>

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbar" aria-expanded="false" aria-controls="navbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="navbar" class="navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
                    <li class="nav-item"><a href="/Events/Index" class="nav-link">Events</a></li>
                    <li class="nav-item"><a href="/Users/Index" class="nav-link">Users</a></li>
                    <li class="nav-item"><a href="/Notifications/IndexNotification" class="nav-link">Notification</a></li>
                </ul>

                @inject demo_02.Servers.NotificationService NotificationService
                @{
                    var allNotifications = (await NotificationService.GetAllNotificationsAsync()).ToList(); // Lấy tất cả thông báo
                    @using demo_02.Models
                }

                <div class="d-flex align-items-center ms-auto">
                    <div id="userDropdown"></div>
                </div>

            </div>
        </div>
    </nav>


    <main class="container" style="margin-top: 1.5rem;">
        @RenderBody()
    </main>
    @RenderSection("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            var navLinks = document.querySelectorAll(".navbar-nav .nav-link");

            navLinks.forEach(function (link) {
                if (link.getAttribute("href").toLowerCase() === currentPath) {
                    link.classList.add("active"); // Đánh dấu active
                } else {
                    link.classList.remove("active"); // Loại bỏ active nếu không khớp
                }
            });
        });

         $(function () {
            $("#userDropdown").dxDropDownButton({
                icon: "user",
                text: "Tài khoản",
                items: [
                    { id: 1, text: "Hồ sơ", icon: "user"},
                    { id: 2, text: "Đăng xuất", icon: "runner", onClick: () => alert("Đăng xuất") }
                ],
                displayExpr: "text",
                keyExpr: "id",
                onItemClick: function (e) {
                    if (e.itemData.id === 1) {
                        // Chuyển hướng khi đăng xuất
                        window.location.href = "Account/Profile";
                    }
                    if (e.itemData.id === 2) {
                        // Chuyển hướng khi đăng xuất
                        window.location.href = "Account/logout";
                    }
                },
                elementAttr: {
                    style: "background-color: white; border: 1px solid #ccc; color: black;"
                }
            });
        });
    </script>

</body>

</html>