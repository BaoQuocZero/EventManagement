@page "{id}"
@model demo_02.Pages.Users.DetailsModel
@{
    ViewData["Title"] = "Chi tiết Người Dùng";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body text-center">
                    <!-- Ảnh đại diện -->
                    <img src="https://ui-avatars.com/api/?name=@Model.CurrentUser.FullName&size=120&rounded=true"
                         class="rounded-circle mb-3 border shadow" alt="Avatar">

                    <h4 class="card-title text-primary"><i class="fas fa-user"></i> @Model.CurrentUser.FullName</h4>

                    <table class="table table-bordered text-start mt-3">
                        <tbody>
                            <tr>
                                <th class="bg-light"><i class="fas fa-id-badge"></i> ID:</th>
                                <td>@Model.CurrentUser.UserId</td>
                            </tr>
                            <tr>
                                <th class="bg-light"><i class="fas fa-envelope"></i> Email:</th>
                                <td>@Model.CurrentUser.Email</td>
                            </tr>
                            <tr>
                                <th class="bg-light"><i class="fas fa-phone"></i> Số điện thoại:</th>
                                <td>@Model.CurrentUser.PhoneNumber</td>
                            </tr>
                            <tr>
                                <th class="bg-light"><i class="fas fa-graduation-cap"></i> Lớp:</th>
                                <td>@Model.CurrentUser.Classname</td>
                            </tr>
                            <tr>
                                <th class="bg-light"><i class="fas fa-user-shield"></i> Vai trò:</th>
                                <td>@Model.CurrentUser.Roles?.Name</td>
                            </tr>
                            <tr>
                                <th class="bg-light"><i class="fas fa-calendar-plus"></i> Ngày tạo:</th>
                                <td>@Model.CurrentUser.CreateAt?.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Thống kê -->
                    <div class="mt-4">
                        <h5 class="text-center text-success"><i class="fas fa-chart-bar"></i> Thống kê cá nhân</h5>
                        <div id="userStats"></div>
                        <div id="eventParticipationChart"></div>
                    </div>
                </div>

                <div class="card-footer text-center">
                    <a asp-page="./Index" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        var userStats = {
            totalEvents: @Model.TotalEvents,
            participatedEvents: @Model.ParticipatedEvents,
            totalDonations: @Model.TotalDonations,
            totalPoints: @Model.TotalPoints,
            participationRate: @Model.ParticipationRate
        };

        $("#userStats").dxForm({
            formData: userStats,
            readOnly: true,
            colCount: 2,
            items: [
                { dataField: "totalEvents", label: { text: "Tổng số sự kiện" }, editorType: "dxNumberBox" },
                { dataField: "participatedEvents", label: { text: "Đã đăng ký" }, editorType: "dxNumberBox" },
                { dataField: "totalPoints", label: { text: "Tổng điểm kiếm được" }, editorType: "dxNumberBox" },
                { dataField: "totalDonations", label: { text: "Tổng tiền donate" }, editorType: "dxNumberBox", editorOptions: { format: "#,##0 VNĐ" } },
                { dataField: "participationRate", label: { text: "Tỷ lệ tham gia (%)" }, editorType: "dxNumberBox", editorOptions: { format: "#.##" } }
            ]
        });

        var chartData = [
            { category: "Đã đăng ký", value: userStats.participatedEvents },
            { category: "Chưa đăng ký", value: userStats.totalEvents - userStats.participatedEvents }
        ];

        $("#eventParticipationChart").dxPieChart({
            type: "doughnut",
            palette: "Soft Pastel",
            dataSource: chartData,
            series: [{
                argumentField: "category",
                valueField: "value",
                label: {
                    visible: true,
                    format: "fixedPoint",
                    precision: 0,
                    connector: { visible: true }
                }
            }],
            legend: {
                horizontalAlignment: "center",
                verticalAlignment: "bottom"
            },
            tooltip: {
                enabled: true,
                format: {
                    type: "fixedPoint",
                    precision: 0
                }
            },
            title: "Tỷ lệ tham gia sự kiện: " + userStats.participationRate.toFixed(2) + "%"
        });
    });
</script>


<!-- Font Awesome (Nếu bạn chưa có) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
