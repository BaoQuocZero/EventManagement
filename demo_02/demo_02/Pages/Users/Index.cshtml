@page
@model IndexModel
@{
    ViewData["Title"] = "Danh sách người dùng";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h3 class="m-0 d-flex align-items-center">
                        <i class="fas fa-users me-2"></i> Danh sách người dùng
                    </h3>
                    <a asp-page="Create" class="btn btn-dark d-flex align-items-center justify-content-center p-2">
                        <i class="fas fa-user-plus fs-4"></i>
                    </a>
                </div>

                <div class="card-body">
                    <div id="userGrid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        $("#userGrid").dxDataGrid({
            dataSource: @Html.Raw(Json.Serialize(Model.Users)),
            keyExpr: "UserId",
            columnAutoWidth: true,
            showBorders: true,
            paging: {
                pageSize: 10
            },
            pager: {
                showPageSizeSelector: true,
                allowedPageSizes: [10, 20, 50],
                showInfo: true
            },
            columns: [
                { dataField: "FullName", caption: "Họ và Tên" },
                { dataField: "Email", caption: "Email" },
                { dataField: "PhoneNumber", caption: "Số điện thoại" },
                { dataField: "Classname", caption: "Lớp" },
                {
                    type: "buttons",
                    buttons: [
                        {
                            hint: "Xem",
                            icon: "fas fa-eye",
                            onClick: function (e) {
                                window.location.href = `/Users/Details/${e.row.data.UserId}`;
                            }
                        },
                        {
                            hint: "Sửa",
                            icon: "edit",
                            onClick: function (e) {
                                window.location.href = `/Users/Edit?id=${e.row.data.UserId}`;
                            }
                        },
                        {
                            hint: "Xóa mềm",
                            icon: "trash",
                            cssClass: "dx-button-danger",
                            onClick: function (e) {
                                if (confirm("Bạn có chắc chắn muốn ẩn người dùng này?")) {
                                    fetch(`/Users/Index?handler=SoftDelete&id=${e.row.data.UserId}`, {
                                        method: "POST",
                                        headers: { "Content-Type": "application/json" }
                                    }).then(() => location.reload());
                                }
                            }
                        }
                    ]
                }
            ]
        });
    });
</script>
